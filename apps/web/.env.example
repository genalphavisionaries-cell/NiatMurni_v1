NEXT_PUBLIC_GO_API_URL=
NEXT_PUBLIC_LARAVEL_API_URL=
# Base URL of the Laravel API (same origin as main site preferred). Admin UI is at https://niatmurniacademy.com/admin — do not use admin.niatmurniacademy.com for the admin UI.
NEXT_PUBLIC_ADMIN_API_URL=
# Optional: Laravel public origin for Filament (no trailing slash). Used by Next.js /admin/users bridge to open the real User management UI. Falls back to LARAVEL_API_URL with /api stripped.
NEXT_PUBLIC_FILAMENT_BASE_URL=
