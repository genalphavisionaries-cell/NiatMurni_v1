# Laravel API origin (required for public + admin API clients). No trailing slash.
# IMPORTANT: do NOT include /api — paths in code append /api/...
# Prefer this name; falls back to NEXT_PUBLIC_API_URL if unset.
# Example: https://api.niatmurniacademy.com
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GO_API_URL=
# Optional: Laravel Filament origin for Next.js /admin/users bridge. Falls back to NEXT_PUBLIC_API_URL with /api stripped.
NEXT_PUBLIC_FILAMENT_BASE_URL=
# Enable CMS debug logs/panel/banner in development only.
# Set to "true" locally when debugging CMS payload/rendering.
NEXT_PUBLIC_CMS_DEBUG=false
